# Copy to .env.production and fill in with real values.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ─── App ──────────────────────────────────────────────
PORT=3000
API_PREFIX=api
CORS_ORIGIN=https://app.rutik.lat

# ─── Database ─────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=use-a-strong-random-password
DB_NAME=rutik_db

# ─── JWT ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ─── Google Maps ──────────────────────────────────────
# Obtain from https://console.cloud.google.com/google/maps-apis with the
# Directions API enabled.
GOOGLE_MAPS_API_KEY=

# ─── PgAdmin (optional, only with --profile tools) ────
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@rutik.com
PGADMIN_PASSWORD=use-a-strong-random-password

# ─── Super admin seed ──────────────────────────────────
# Not part of the app's environment (not read on every start) — run
# once after the first deploy, passed directly to the one-off command:
#   docker compose -f docker-compose.prod.yml exec \
#     -e SUPER_ADMIN_EMAIL=admin@rutik.lat \
#     -e SUPER_ADMIN_PASSWORD=... \
#     -e SUPER_ADMIN_DOCUMENT=... \
#     -e SUPER_ADMIN_FIRST_NAME=Super \
#     -e SUPER_ADMIN_LAST_NAME=Admin \
#     app pnpm run seed:super-admin:prod


# Resend
RESEND_API_KEY=
MAIL_FROM=