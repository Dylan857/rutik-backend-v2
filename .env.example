# ─── App ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200
# Where the guardian account-activation email link points
# (createActivationLink builds "$PARENTS_APP_URL/set-password?token=...").
# Use the parents-rutik web URL (e.g. http://localhost:4201), or
# rutik://activate to open rutik-mobile's activation screen instead.
PARENTS_APP_URL=http://localhost:4201

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rutik_db

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-strong-secret-here
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-strong-refresh-secret-here
JWT_REFRESH_EXPIRATION=7d

# ─── Google Maps ──────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── PgAdmin (optional) ───────────────────────────────
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ─── Super admin seed (only for `pnpm run seed:super-admin`) ──
# Not read by the running app — only needed once, to bootstrap the
# first super admin. Safe to remove from .env after running it.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password
SUPER_ADMIN_DOCUMENT=0000000000
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Resend
RESEND_API_KEY=
MAIL_FROM=

# ─── Cloudinary (payment receipt photos) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
